# GEMINI_API_KEY: Optional for optional server-side AI assistant features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional NASA Earthdata Login Bearer Token (server-side only; never expose to client)
NASA_EARTHDATA_TOKEN=""

# NASA API Base URLs (public endpoints require no token)
NASA_CMR_BASE_URL="https://cmr.earthdata.nasa.gov/search"
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal"
NASA_GIBS_WMTS_BASE_URL="https://gibs.earthdata.nasa.gov/wmts/epsg3857/best"
